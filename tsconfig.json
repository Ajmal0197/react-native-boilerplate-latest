{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@components": ["src/components/index.ts"],
      "@features/*": ["src/features/*"],
      "@hooks/*": ["src/hooks/*"],
      "@hooks": ["src/hooks/index.ts"],
      "@locales/*": ["src/locales/*"],
      "@locales": ["src/locales/index.ts"],
      "@navigation/*": ["src/navigation/*"],
      "@navigation": ["src/navigation/index.ts"],
      "@services/*": ["src/services/*"],
      "@services": ["src/services/index.ts"],
      "@store/*": ["src/store/*"],
      "@store": ["src/store/index.ts"],
      "@theme/*": ["src/theme/*"],
      "@theme": ["src/theme/index.ts"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils/index.ts"],
      "@api/*": ["src/api/*"],
      "@api": ["src/api/index.ts"],
      "@assets/*": ["src/assets/*"],
      "@native/*": ["src/native/*"],
      "@native": ["src/native/index.ts"],
      "@appTypes/*": ["src/types/*"],
      "@appTypes": ["src/types/index.ts"],
      "@config/*": ["src/config/*"],
      "@config": ["src/config/index.ts"],
      "@test-utils": ["__tests__/test-utils.tsx"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "specs/**/*", "__tests__/**/*", "index.js"],
  "exclude": ["**/node_modules", "**/Pods", "babel.config.js", "jest.config.js"]
}
