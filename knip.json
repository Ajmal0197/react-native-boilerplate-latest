{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,tsx}", "specs/**/*.{ts,tsx}"],
  "entry": ["reactotron.config.ts"],
  "ignoreDependencies": [
    "@babel/preset-env",
    "@babel/runtime",
    "babel-jest"
  ],
  "ignoreBinaries": ["xed", "pod", "adb"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off",
    "exports": "warn"
  }
}
