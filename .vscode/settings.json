{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.removeUnreachableCode": "always",
    "source.organizeImports": "never"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.autoSave": "off",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.format.enable": false,
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "javascript.preferences.quoteStyle": "single",
  "typescript.preferences.quoteStyle": "single",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "jest.autoRun": "off",
  "jest.disabledWorkspaceFolders": ["RN_BoilerplateLatest"],
  "search.exclude": {
    "**/.git": true,
    "**/.jso": true,
    "**/bower_components": true,
    "**/build": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/ios/Pods": true,
    "**/android/.gradle": true,
    "**/coverage": true,
    "**/*.lock": true
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.idea": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/node_modules": false,
    "**/Thumbs.db": true,
    "**/ios/Pods": true,
    "**/android/.gradle": true,
    "**/android/build": true,
    "**/android/app/build": true,
    "**/ios/build": true
  },
  "sonarlint.rules": {
    "typescript:S9383": { "level": "off" },
    "javascript:S9383": { "level": "off" },
    "typescript:S1192": { "level": "off" },
    "typescript:S3776": { "level": "off" },
    "typescript:S3358": { "level": "off" },
    "typescript:S1186": { "level": "off" },
    "typescript:S125": { "level": "off" },
    "typescript:S6478": { "level": "off" },
    "typescript:S6480": { "level": "off" },
    "typescript:S107": { "level": "off" },
    "javascript:S1192": { "level": "off" },
    "javascript:S3776": { "level": "off" },
    "javascript:S3358": { "level": "off" },
    "javascript:S1186": { "level": "off" },
    "javascript:S125": { "level": "off" }
  },
  "sonarqube.rules": {
    "typescript:S9383": { "level": "off" },
    "javascript:S9383": { "level": "off" }
  }
}
