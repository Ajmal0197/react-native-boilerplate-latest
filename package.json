{
  "name": "RN_Boilerplate_Latest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start --reset-cache",
    "android": "react-native run-android --mode=developmentDebug --appIdSuffix=dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "react-native run-android --mode=productionDebug",
    "ios": "react-native run-ios --scheme RN_Boilerplate_Latest_Dev",
    "ios:staging": "react-native run-ios --scheme RN_Boilerplate_Latest_Staging",
    "ios:prod": "react-native run-ios --scheme RN_Boilerplate_Latest",
    "build:android": "cd android && ./gradlew assembleProductionRelease && cd ..",
    "build:android:debug": "cd android && ./gradlew assembleDevelopmentDebug && cd ..",
    "bundle:android": "cd android && ./gradlew bundleProductionRelease && cd ..",
    "build:ios": "react-native build-ios --mode Release --scheme RN_Boilerplate_Latest",
    "install:all": "yarn install && (bundle install || true) && cd ios && (bundle exec pod install || pod install) && cd ..",
    "clean:install": "bash scripts/clean-install.sh",
    "postinstall": "patch-package",
    "prepare": "husky",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:8081 tcp:8081 && adb reverse tcp:3000 tcp:3000",
    "open:ios": "xed -b ios",
    "open:android": "open -a \"Android Studio\" android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check src __tests__ specs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "knip:check": "knip",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test:coverage && yarn knip:check",
    "ci": "bash scripts/ci.sh",
    "sonar": "yarn test:coverage && sonar-scanner",
    "sonar:start": "docker-compose up -d",
    "sonar:stop": "docker-compose stop",
    "sonar:open": "open http://localhost:9000/dashboard?id=RN_Boilerplate_Latest"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@legendapp/list": "^3.7.2",
    "@lokal-dev/react-native-bugbubble": "^1.0.2",
    "@notifee/react-native": "^9.1.8",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@swmansion/react-native-bottom-sheet": "^1.1.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "i18next": "^27.1.5",
    "react": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-native": "0.88.1",
    "react-native-error-boundary": "^3.1.0",
    "react-native-gesture-handler": "3.5.0",
    "react-native-keyboard-controller": "^1.23.1",
    "react-native-keys": "^0.7.13",
    "react-native-localize": "^3.7.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-pager-view": "^10.0.3",
    "react-native-reanimated": "4.8.0",
    "react-native-restart": "^0.0.29",
    "react-native-root-siblings": "^5.0.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-tab-view": "^4.3.5",
    "react-native-toast-message": "^2.5.2",
    "react-native-unistyles": "^3.8.2",
    "react-native-worklets": "^0.14.0",
    "react-redux": "^9.3.1",
    "yup": "^1.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^9.39.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@sonar/scan": "^4.4.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "knip": "^6.45.1",
    "lint-staged": "17.6.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.10.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "reactotron-plugin-zustand": "^2.0.9",
    "reactotron-react-native": "^5.3.1",
    "reactotron-redux": "^3.2.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "all",
    "jsSrcsDir": "./specs"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "browserslist": [
    "> 0.2%",
    "not dead"
  ],
  "packageManager": "yarn@3.6.4",
  "resolutions": {
    "axios": "^1.21.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
